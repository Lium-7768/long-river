{
  "name": "long-river-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
