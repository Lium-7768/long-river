# ============================================================
# 长河 · 环境变量模板
# ------------------------------------------------------------
# 复制为 .env 后填写。**数据源四选一**，按优先级从高到低：
#   TURSO_DATABASE_URL > DATABASE_URLS(4 分片 PG) > DATABASE_URL(单库 PG) > 本地 SQLite
# 全部留空 → 走本地 SQLite（data/db/lr-song.sqlite3），无需任何配置。
#
# 启动：node --env-file=.env server/src/index.js
# ============================================================

# ---------- 1. Turso（推荐：SQLite 方言，无需分片）----------
# turso db show long-river --url  取 URL
# turso db tokens create long-river  取 token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 可选：嵌入式副本路径。设置后读本地文件（本机 mmap，最快），启动时从远端同步一次。
# 不设则每条查询走 HTTPS（简单但慢，适合小数据量）。
# TURSO_REPLICA=file:data/db/turso-replica.db

# ---------- 2. PostgreSQL 4 分片（Neon Free 时代的方案）----------
# JSON：{"qing":"postgresql://...","ming":"...","tangsong":"...","rest":"..."}
DATABASE_URLS=

# ---------- 3. PostgreSQL 单库 ----------
DATABASE_URL=

# ---------- 4. 本地 SQLite（默认，零配置）----------
# LR_DB=data/db/lr-song.sqlite3

# ---------- 服务端口 ----------
# PORT=8787
